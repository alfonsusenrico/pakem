{
  "pakem-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|.*read.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/share/pakem/guard.py\" --host antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "pakem-status": {
    "SessionStart": [
      {
        "type": "command",
        "command": "{{pakem}} status --hook session-start --host antigravity",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "{{pakem}} status --hook prompt --host antigravity",
        "timeout": 10
      }
    ]
  }
}
