# agent-framework execpolicy rules for Codex (Starlark).
# Installed to ~/.codex/rules/agent-framework.rules by `af enforce install --host codex`.
# Prefix rules only see leading argv tokens, so they cover the common spellings;
# the git pre-push and commit-msg hooks remain the authoritative checks.

# Codex execpolicy rules are static and cannot read a repository's
# agentframework.protectedBranch git config, so `development` (the usual
# integration branch for repositories that do not merge straight into main) is
# protected globally here; the guard and pre-push hook use the per-repository set.
PROTECTED_BRANCH_REFSPECS = [
    "main",
    "master",
    "development",
    "HEAD:main",
    "HEAD:master",
    "HEAD:development",
    "+main",
    "+master",
    "+development",
    ":main",
    ":master",
    ":development",
    "refs/heads/main",
    "refs/heads/master",
    "refs/heads/development",
    "HEAD:refs/heads/main",
    "HEAD:refs/heads/master",
    "HEAD:refs/heads/development",
]

FORCE_FLAGS = ["--force", "-f", "--force-with-lease", "--force-if-includes"]

prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], PROTECTED_BRANCH_REFSPECS],
    decision = "forbidden",
    justification = "Direct pushes to main, master, or development are blocked; push a topic branch and let the owner merge.",
    match = [
        "git push origin main",
        "git push origin HEAD:main",
        "git push upstream master",
        "git push origin development",
        "git push origin HEAD:refs/heads/development",
    ],
    not_match = [
        "git push origin feat/x",
        "git push origin main-docs",
        "git push origin development-docs",
    ],
)

prefix_rule(
    pattern = ["git", "push", FORCE_FLAGS],
    decision = "forbidden",
    justification = "Force pushes rewrite shared history; ask the owner to run it if it is really needed.",
    match = [
        "git push --force origin feat/x",
        "git push -f",
    ],
    not_match = ["git push origin feat/x"],
)

prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], FORCE_FLAGS],
    decision = "forbidden",
    justification = "Force pushes rewrite shared history; ask the owner to run it if it is really needed.",
    match = ["git push origin --force-with-lease"],
)

prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "forbidden",
    justification = "Do not bypass the pre-push hook; fix the reported problem instead.",
    match = ["git push --no-verify origin feat/x"],
)

prefix_rule(
    pattern = ["git", "commit", ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Do not bypass the commit-msg hook; commits are subject-only conventional messages.",
    match = [
        "git commit --no-verify -m x",
        "git commit -n -m x",
    ],
    not_match = ["git commit -m x"],
)

prefix_rule(
    pattern = ["printenv"],
    decision = "forbidden",
    justification = "Environment dumps can expose secrets; read variable names with skills/sensitive-operations/scripts/env_keys.py instead.",
    match = ["printenv", "printenv HOME"],
)
