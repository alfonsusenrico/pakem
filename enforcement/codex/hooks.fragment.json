{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{{pakem}} status --hook session-start --host codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{pakem}} status --hook prompt --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
